# ---- Gnani (required) ----
# Create at https://app.gnani.ai  (never commit this file)
GNANI_API_KEY=

# ---- Translation LLM (required) ----
# Any OpenAI-compatible chat endpoint works. Examples (check each provider's current docs/model names):
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
#   Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=llama-3.3-70b-versatile
#   Evon   : if you serve Gnani Evon yourself with vLLM, point LLM_BASE_URL at it (e.g. http://localhost:8000/v1)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional for reasoning models (low/medium/high). Sent only when set.
LLM_REASONING_EFFORT=

# ---- Optional ----
STT_MODEL=prisma-v3.0
TTS_MODEL=timbre-v2.5
FALLBACK_VOICE=Nalini
